# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/specresearch
S3_ENDPOINT_URL=http://localhost:9010
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=specresearch
S3_REGION=ap-southeast-1
JWT_SECRET=dev-change-me-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000

# Research providers. Keep fake for deterministic local development/tests.
# Comma-separated discovery providers: semantic_scholar, openalex, or fake.
RESEARCH_SOURCE_PROVIDER=semantic_scholar
RESEARCH_PROVIDER_TIMEOUT_SECONDS=15
RESEARCH_CANDIDATE_LIMIT=50
RESEARCH_SEARCH_QUERY_LIMIT=4
RESEARCH_COUNTER_QUERY_LIMIT=8
RESEARCH_GRAPH_SEED_COUNT=5
RESEARCH_RERANK_ENABLED=true
RESEARCH_RERANK_CANDIDATE_LIMIT=20
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_PUBLIC_FALLBACK_ENABLED=true
OPENALEX_MAILTO=
OPENALEX_API_KEY=
# Downloaded/extracted UTF-8 paper text is stored in the configured S3 bucket.
# Use memory only for tests; use disabled to skip text persistence.
RESEARCH_TEXT_STORAGE=s3
RESEARCH_TEXT_TIMEOUT_SECONDS=30
RESEARCH_TEXT_MAX_BYTES=20000000
RESEARCH_REQUIRE_DOWNLOADABLE_FULL_TEXT=true

LLM_API_KEY=
LLM_BASE_URL=https://ai-fit.hcmus.edu.vn/openai
LLM_DEFAULT_MODEL=Qwen3.6-27B
LLM_TRACE=false

# Optional ADR 0034 JSON. Secrets stay in env vars named by api_key_env.
# Empty LLM_PROVIDERS / LLM_PROFILES → built-in Provider ai-fit + fake; all Profiles → ai-fit.
# base_url may be a literal URL or an env var name (e.g. LLM_BASE_URL).
# Migration: provider_id "openai" in LLM_PROFILES needs a matching Provider entry or retarget to ai-fit.
# LLM_PROVIDERS={"ai-fit":{"kind":"langchain","api_key_env":"LLM_API_KEY","base_url":"LLM_BASE_URL"},"gemini":{"kind":"langchain","api_key_env":"GEMINI_API_KEY","base_url":"GEMINI_BASE_URL"},"fake":{"kind":"fake"}}
# LLM_PROFILES={"creative":{"provider_id":"gemini","model":"gemini-2.0-flash"},"research":{"provider_id":"ai-fit","model":"Qwen3.6-27B"},"structured":{"provider_id":"ai-fit","model":"Qwen3.6-27B"},"judge":{"provider_id":"gemini","model":"gemini-2.0-flash"}}
# LLM_NODE_PROFILE_OVERRIDES={"gap":"creative"}
