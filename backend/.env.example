# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/specresearch
S3_ENDPOINT_URL=http://localhost:9010
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=specresearch
S3_REGION=ap-southeast-1
JWT_SECRET=dev-change-me-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000

# Research providers. Keep fake for deterministic local development/tests.
# Comma-separated discovery providers: semantic_scholar, openalex, or fake.
RESEARCH_SOURCE_PROVIDER=semantic_scholar
RESEARCH_PROVIDER_TIMEOUT_SECONDS=15
RESEARCH_CANDIDATE_LIMIT=50
RESEARCH_SEARCH_QUERY_LIMIT=4
RESEARCH_COUNTER_QUERY_LIMIT=4
RESEARCH_GRAPH_SEED_COUNT=5
RESEARCH_RERANK_ENABLED=true
RESEARCH_RERANK_CANDIDATE_LIMIT=20
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_PUBLIC_FALLBACK_ENABLED=true
OPENALEX_MAILTO=
OPENALEX_API_KEY=
# Downloaded/extracted UTF-8 paper text is stored in the configured S3 bucket.
# Use memory only for tests; use disabled to skip text persistence.
RESEARCH_TEXT_STORAGE=s3
RESEARCH_TEXT_TIMEOUT_SECONDS=30
RESEARCH_TEXT_MAX_BYTES=20000000
RESEARCH_LLM_PROVIDER=fit_webui
RESEARCH_LLM_MODEL=Qwen3.6-27B

# FIT@HCMUS personal key from WebUI: Settings -> Account -> Show API Key.
# Set RESEARCH_LLM_PROVIDER=fit_webui for live generation.
FIT_WEBUI_API_KEY=
FIT_WEBUI_BASE_URL=https://ai-fit.hcmus.edu.vn/openai
FIT_WEBUI_TIMEOUT_SECONDS=120
FIT_WEBUI_MAX_TOKENS=2000

LLM_API_KEY=
LLM_BASE_URL=
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_TRACE=false
